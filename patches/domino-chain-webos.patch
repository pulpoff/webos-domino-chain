+
+#ifndef __WEBOS_H__
+#define __WEBOS_H__
+
+// LG webOS TVs: the game runs from its app folder, with the remote or a game controller, and
+// goes into the background with the remote's Home button.
+
+#ifdef WEBOS
+
+#include <SDL.h>
+
+// Before anything else: the app folder becomes the working directory (so ./data is found) and its
+// home/ the user's home (the levels solved, the profiles).
+void webOSInit(void);
+
+// After SDL_Init: the event filter that turns the remote's Back and the game controller into keys,
+// and notices the game going into the background and back.
+void webOSInitSDL(void);
+
+// Opens the game controllers connected meanwhile: called from the main loop
+void webOSPoll(void);
+
+// Whether the game controller holds the key with that scancode (the arrows, Return)
+bool webOSPadHeld(SDL_Scancode scancode);
+
+// Whether the game is in the background (the TV shows the launcher or another app)
+bool webOSInBackground(void);
+
+#endif
+
+#endif
