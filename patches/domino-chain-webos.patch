diff --git a/src/domino-chain/webos.cpp b/src/domino-chain/webos.cpp
new file mode 100644
index 0000000..a41fe81
--- /dev/null
+++ b/src/domino-chain/webos.cpp
@@ -0,0 +1,294 @@
+/* Domino-Chain
+ *
+ * Domino-Chain is the legal property of its developers, whose
+ * names are listed in the AUTHORS file, which is included
+ * within the source distribution.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 3
+ * of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1335 USA
+ */
+
+#ifdef WEBOS
+
+#include "webos.h"
+
+#include <SDL_mixer.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#include <execinfo.h>
+#include <limits.h>
+#include <signal.h>
+#include <ucontext.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static bool inBackground = false;
+static bool padHeld[SDL_NUM_SCANCODES];
+static bool padsChanged = true;
+
+// A crash leaves where it happened in the log (the registers, then the backtrace, which on ARM
+// often stops at the signal frame), with where the game and SDL were loaded, to look the
+// addresses up in the unstripped binaries (addr2line)
+static void crashHandler(int sig, siginfo_t * info, void * context)
+{
+  const ucontext_t * uc = (const ucontext_t *)context;
+  fprintf(stderr, "webOS: signal %d at %p: pc %#lx lr %#lx sp %#lx, thread %d of %d\n", sig, info->si_addr,
+    (unsigned long)uc->uc_mcontext.arm_pc, (unsigned long)uc->uc_mcontext.arm_lr,
+    (unsigned long)uc->uc_mcontext.arm_sp, (int)syscall(SYS_gettid), (int)getpid());
+  void * frames[64];
+  const int n = backtrace(frames, 64);
+  backtrace_symbols_fd(frames, n, fileno(stderr));
+  if (FILE * maps = fopen("/proc/self/maps", "r"))
+  {
+    char line[512];
+    while (fgets(line, sizeof(line), maps))
+      if (strstr(line, "r-xp") && (strstr(line, "domino-chain") || strstr(line, ".so")))
+        fputs(line, stderr);
+    fclose(maps);
+  }
+  fflush(stderr);
+  signal(sig, SIG_DFL);
+  raise(sig);
+}
+
+void webOSInit(void)
+{
+  struct sigaction sa;
+  memset(&sa, 0, sizeof(sa));
+  sa.sa_sigaction = crashHandler;
+  sa.sa_flags = SA_SIGINFO;
+  for (int sig : { SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT })
+    sigaction(sig, &sa, NULL);
+
+  // what the game prints goes to a log, as the app manager drops it
+  if (freopen("/tmp/domino-chain.log", "w", stdout))
+  {
+    dup2(fileno(stdout), fileno(stderr));
+    setvbuf(stdout, NULL, _IOLBF, 0);
+  }
+
+  // the app folder is the executable's
+  char exe[PATH_MAX];
+  ssize_t n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+  if (n > 0)
+  {
+    exe[n] = '\0';
+    std::string dir(exe);
+    dir.erase(dir.rfind('/'));
+    if (chdir(dir.c_str()) != 0)
+      perror(dir.c_str());
+
+    // The app runs as its own user, and the app folder is root's: home/ is made writable by
+    // anyone when the app is packaged, and the installer keeps it when the app is updated.
+    std::string home = dir + "/home";
+    mkdir(home.c_str(), 0777);
+    // where the game keeps them, which it makes itself but for its parents
+    mkdir((home + "/.local").c_str(), 0755);
+    mkdir((home + "/.local/share").c_str(), 0755);
+    setenv("HOME", home.c_str(), 1);
+    printf("webOS: app %s, home %s\n", dir.c_str(), home.c_str());
+  }
+
+  // the remote's Back button goes to the game (it is Escape), rather than closing it
+  setenv("SDL_WEBOS_ACCESS_POLICY_KEYS_BACK", "true", 1);
+}
+
+// The game controller's buttons are keys: Cross [A] is Return (choosing in the menus, the action
+// in a level, with Space), Circle [B] and Options [Start] are Escape (back; the level's menu),
+// Triangle [Y] is F1 (help), the D-pad and the left stick the arrows.
+static const struct
+{
+  SDL_GameControllerButton button;
+  SDL_Keycode key;
+  SDL_Scancode scancode;
+} padKeys[] = {
+  { SDL_CONTROLLER_BUTTON_DPAD_UP, SDLK_UP, SDL_SCANCODE_UP },
+  { SDL_CONTROLLER_BUTTON_DPAD_DOWN, SDLK_DOWN, SDL_SCANCODE_DOWN },
+  { SDL_CONTROLLER_BUTTON_DPAD_LEFT, SDLK_LEFT, SDL_SCANCODE_LEFT },
+  { SDL_CONTROLLER_BUTTON_DPAD_RIGHT, SDLK_RIGHT, SDL_SCANCODE_RIGHT },
+  { SDL_CONTROLLER_BUTTON_A, SDLK_RETURN, SDL_SCANCODE_RETURN },
+  { SDL_CONTROLLER_BUTTON_B, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE },
+  { SDL_CONTROLLER_BUTTON_START, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE },
+  { SDL_CONTROLLER_BUTTON_Y, SDLK_F1, SDL_SCANCODE_F1 },
+};
+
+// Makes *e the key event for that key
+static void keyEvent(SDL_Event * e, bool down, SDL_Keycode key, SDL_Scancode scancode)
+{
+  const Uint32 timestamp = e->common.timestamp;
+  SDL_zerop(e);
+  e->type = down ? SDL_KEYDOWN : SDL_KEYUP;
+  e->key.timestamp = timestamp;
+  e->key.state = down ? SDL_PRESSED : SDL_RELEASED;
+  e->key.keysym.sym = key;
+  e->key.keysym.scancode = scancode;
+  padHeld[scancode] = down;
+}
+
+static void setBackground(bool background, const char * why)
+{
+  if (background == inBackground)
+    return;
+  inBackground = background;
+  printf("webOS: %s (%s)\n", background ? "in the background" : "in front again", why);
+  if (background)
+  {
+    Mix_PauseMusic();
+    Mix_Pause(-1);
+  }
+  else
+  {
+    Mix_ResumeMusic();
+    Mix_Resume(-1);
+  }
+}
+
+// Rewrites the events as they are queued: returns 0 to drop one
+static int SDLCALL eventFilter(void *, SDL_Event * e)
+{
+  switch (e->type)
+  {
+    case SDL_KEYDOWN:
+    case SDL_KEYUP:
+      // the remote's Back button is Escape, its red button F1 (help)
+      if (e->key.keysym.scancode == SDL_SCANCODE_WEBOS_BACK || e->key.keysym.sym == SDLK_AC_BACK)
+      {
+        e->key.keysym.sym = SDLK_ESCAPE;
+        e->key.keysym.scancode = SDL_SCANCODE_ESCAPE;
+      }
+      else if (e->key.keysym.scancode == SDL_SCANCODE_WEBOS_RED)
+      {
+        e->key.keysym.sym = SDLK_F1;
+        e->key.keysym.scancode = SDL_SCANCODE_F1;
+      }
+      return 1;
+
+    case SDL_CONTROLLERDEVICEADDED:
+      // opened by webOSPoll, outside SDL's event dispatch, which this filter runs within
+      padsChanged = true;
+      return 0;
+
+    case SDL_CONTROLLERBUTTONDOWN:
+    case SDL_CONTROLLERBUTTONUP:
+      if (inBackground)
+        return 0;
+      for (const auto & k : padKeys)
+        if (k.button == e->cbutton.button)
+        {
+          keyEvent(e, e->type == SDL_CONTROLLERBUTTONDOWN, k.key, k.scancode);
+          return 1;
+        }
+      return 0;
+
+    case SDL_CONTROLLERAXISMOTION:
+    {
+      // the left stick is the arrows, pressed beyond half way and released within a third
+      SDL_Scancode neg, pos;
+      SDL_Keycode negKey, posKey;
+      if (e->caxis.axis == SDL_CONTROLLER_AXIS_LEFTX)
+      {
+        neg = SDL_SCANCODE_LEFT; negKey = SDLK_LEFT; pos = SDL_SCANCODE_RIGHT; posKey = SDLK_RIGHT;
+      }
+      else if (e->caxis.axis == SDL_CONTROLLER_AXIS_LEFTY)
+      {
+        neg = SDL_SCANCODE_UP; negKey = SDLK_UP; pos = SDL_SCANCODE_DOWN; posKey = SDLK_DOWN;
+      }
+      else
+        return 0;
+      if (inBackground)
+        return 0;
+      const int v = e->caxis.value;
+      if (v < -16384 && !padHeld[neg])
+      {
+        padHeld[pos] = false;
+        keyEvent(e, true, negKey, neg);
+        return 1;
+      }
+      if (v > 16384 && !padHeld[pos])
+      {
+        padHeld[neg] = false;
+        keyEvent(e, true, posKey, pos);
+        return 1;
+      }
+      if (v > -10000 && padHeld[neg])
+      {
+        keyEvent(e, false, negKey, neg);
+        return 1;
+      }
+      if (v < 10000 && padHeld[pos])
+      {
+        keyEvent(e, false, posKey, pos);
+        return 1;
+      }
+      return 0;
+    }
+
+    case SDL_WINDOWEVENT:
+      switch (e->window.event)
+      {
+        case SDL_WINDOWEVENT_FOCUS_LOST: setBackground(true, "focus lost"); break;
+        case SDL_WINDOWEVENT_HIDDEN: setBackground(true, "hidden"); break;
+        case SDL_WINDOWEVENT_MINIMIZED: setBackground(true, "minimized"); break;
+        case SDL_WINDOWEVENT_FOCUS_GAINED: setBackground(false, "focus gained"); break;
+        case SDL_WINDOWEVENT_SHOWN: setBackground(false, "shown"); break;
+        case SDL_WINDOWEVENT_RESTORED: setBackground(false, "restored"); break;
+      }
+      return 1;
+
+    case SDL_APP_WILLENTERBACKGROUND:
+    case SDL_APP_DIDENTERBACKGROUND:
+      setBackground(true, "app in the background");
+      return 1;
+
+    case SDL_APP_DIDENTERFOREGROUND:
+      setBackground(false, "app in the foreground");
+      return 1;
+  }
+  return 1;
+}
+
+void webOSInitSDL(void)
+{
+  SDL_SetEventFilter(eventFilter, NULL);
+  if (SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER) != 0)
+    printf("webOS: no game controllers: %s\n", SDL_GetError());
+}
+
+void webOSPoll(void)
+{
+  if (!padsChanged)
+    return;
+  padsChanged = false;
+  for (int i = 0; i < SDL_NumJoysticks(); i++)
+    if (SDL_IsGameController(i) && !SDL_GameControllerFromInstanceID(SDL_JoystickGetDeviceInstanceID(i)))
+      if (SDL_GameController * pad = SDL_GameControllerOpen(i))
+        printf("webOS: game controller %s\n", SDL_GameControllerName(pad));
+}
+
+bool webOSPadHeld(SDL_Scancode scancode)
+{
+  return padHeld[scancode];
+}
+
+bool webOSInBackground(void)
+{
+  return inBackground;
+}
+
+#endif
